# ============================================================
# NETWORK / API
# ============================================================
# Use the LAN IP of the PC running BOTH Vite and Spring Boot.
VITE_API_BASE_URL=http://YOUR_LAN_IP:8080/api
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# ============================================================
# APPLICATION
# ============================================================
VITE_APP_ENV=development

# ============================================================
# FEATURE FLAGS
# ============================================================
VITE_FEATURE_TICKET_RELATIONS=true
VITE_FEATURE_TICKET_SUBSCRIBERS=true
VITE_FEATURE_SAVED_VIEWS=true
VITE_FEATURE_WEB_PUSH=false
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_DOCUMENTS=false
VITE_FEATURE_REALTIME=false
VITE_FEATURE_SETTINGS=false
